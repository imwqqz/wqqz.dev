---
import Base from "../layouts/Base.astro";
import { contacts } from "../lib/info.ts";
---

<Base title="wqqz - Cybersecurity Specialist"
      description="Cybersecurity professional specializing in penetration testing, threat analysis, and security architecture">

    <section class="container mx-auto px-6 py-16 flex-grow flex flex-col justify-center">
        <div class="max-w-3xl mx-auto w-full">
            <h1 class="mb-2 text-4xl md:text-5xl font-bold tracking-tight text-balance">wqqz</h1>
            <p class="mb-4 text-lg md:text-xl text-muted-foreground">
                Cybersecurity Specialist&nbsp;<span class="text-border mx-1">·</span>Security Enthusiast
            </p>

            <p class="mb-4 text-base md:text-lg text-foreground/85 leading-relaxed text-pretty">
                Security enthusiast interested in offensive security, vulnerability research, and threat intelligence —
                and equally at home in distributed systems, machine learning, and the future of computing.
            </p>
            <p class="mb-10 text-base md:text-lg text-foreground/85 leading-relaxed text-pretty">
                Thanks for visiting! I'm usually just taking a nap.
            </p>

            <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
                {contacts.map((contact) => (
                        <div>
                            [{contact.label}: <a
                                href={contact.href}
                                target={contact.target}
                                rel={contact.rel}
                                class="text-muted-foreground underline underline-offset-2 decoration-accent/50 hover:text-accent hover:decoration-accent transition-colors"
                        >{contact.text}</a>]
                        </div>
                ))}
            </div>
        </div>
    </section>

</Base>