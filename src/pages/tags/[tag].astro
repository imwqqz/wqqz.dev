---
import Base from "../../layouts/Base.astro";
import { getArchivePosts } from "../../lib/archive_data";
import { getAllTags, slugifyTag } from "../../lib/tags";
import { ChevronRight } from "@lucide/astro";
import type { Post } from "../../lib/search";

export async function getStaticPaths() {
  const posts = await getArchivePosts();
  const tags = getAllTags(posts);

  return tags.map((tagInfo) => {
    const matchingPosts = posts.filter((post) =>
      post.tags?.some((t) => slugifyTag(t) === tagInfo.slug)
    );
    return {
      params: { tag: tagInfo.slug },
      props: {
        tag: tagInfo.name,
        slug: tagInfo.slug,
        posts: matchingPosts,
        totalTags: tags.length,
      },
    };
  });
}

interface Props {
  tag: string;
  slug: string;
  posts: Post[];
  totalTags: number;
}

const { tag, posts } = Astro.props;

function formatDisplayDate(dateStr?: string): string {
  if (!dateStr) return '';
  try {
    const date = new Date(dateStr);
    if (!isNaN(date.getTime())) {
      return date.toLocaleDateString('en-US', {
        month: 'short',
        day: 'numeric',
        year: 'numeric',
        timeZone: 'UTC',
      });
    }
  } catch {
  }
  return dateStr;
}
---

<Base title={`#${tag} - Tags`} description={`Articles tagged with ${tag}.`}>
  <section class="container mx-auto px-6 pt-16 pb-20">
    <div class="max-w-3xl mx-auto">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex flex-wrap items-center gap-1.5 text-xs text-muted-foreground">
          <li class="flex items-center gap-1.5">
            <a href="/" class="transition-colors hover:text-foreground">Home</a>
          </li>
          <li class="flex items-center gap-1.5">
            <ChevronRight size={12} class="opacity-60" />
            <a href="/tags" class="transition-colors hover:text-foreground">Tags</a>
          </li>
          <li class="flex items-center gap-1.5">
            <ChevronRight size={12} class="opacity-60" />
            <span aria-current="page" class="font-medium text-foreground">{tag}</span>
          </li>
        </ol>
      </nav>

      <header class="mb-10">
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
          <span class="text-accent">#</span>{tag}
        </h1>
        <p class="mt-3 text-base text-muted-foreground">
          {posts.length} {posts.length === 1 ? 'article' : 'articles'} tagged with “{tag}”.
        </p>
      </header>

      <div class="mt-8 space-y-10 sm:space-y-12">
        {posts.map((post) => (
          <article class="group">
            <div class="flex items-start justify-between gap-6 sm:gap-8">
              <div class="flex-1 min-w-0">
                <h2 class="text-lg sm:text-xl font-bold tracking-tight text-foreground group-hover:text-primary transition-colors text-balance">
                  <a href={`/archives/${post.slug}`} class="hover:text-primary">
                    {post.title}
                  </a>
                </h2>
                <p class="mt-2 mb-3 text-sm sm:text-base text-muted-foreground leading-relaxed text-pretty">
                  {post.excerpt}
                </p>
                {post.tags && post.tags.length > 0 && (
                  <div class="flex flex-wrap gap-1.5">
                    {post.tags.map((t) => (
                      <a
                        href={`/tags/${slugifyTag(t)}`}
                        class="inline-flex items-center gap-1 rounded-md border border-border/60 bg-card/60 px-2 py-0.5 font-mono text-xs text-muted-foreground transition-colors hover:border-accent/40 hover:text-accent"
                      >
                        <span class="text-accent/70">#</span>
                        <span>{t}</span>
                      </a>
                    ))}
                  </div>
                )}
              </div>
              <div class="text-right shrink-0 whitespace-nowrap pt-0.5">
                <time class="text-xs sm:text-sm text-muted-foreground block">
                  {formatDisplayDate(post.date)}
                </time>
                {typeof post.readMinutes === 'number' && (
                  <span class="text-xs text-muted-foreground/70 block mt-0.5">
                    {post.readMinutes} min read
                  </span>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>
