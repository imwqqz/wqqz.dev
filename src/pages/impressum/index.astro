---
import Base from "../../layouts/Base.astro";
import { info } from "../../lib/info";

const sectionTitle = "text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-3";
const paragraph = "mb-3 text-base text-foreground/85 leading-relaxed text-pretty";
const link = "text-muted-foreground underline underline-offset-2 decoration-accent/50 hover:text-accent hover:decoration-accent transition-colors";
---

<Base title={`Impressum - ${info.site.name}`}
      description={`Impressum von ${info.name}.`}
      noindex>

    <section class="container mx-auto px-6 pt-16 pb-20 flex-grow">
        <div class="max-w-3xl mx-auto w-full">
            <h1 class="mb-8 text-4xl md:text-5xl font-bold tracking-tight text-balance">Impressum</h1>

            <div class="mb-10">
                <p class={paragraph}>
                    Tobias Schlößer<br/>
                    Hamerhütte 53<br/>
                    41068 Mönchengladbach
                </p>
            </div>

            <div class="mb-10">
                <h2 class={sectionTitle}>Kontakt</h2>
                <p class={paragraph}>
                    E-Mail: mail (at) tobiasschloesser.de
                </p>
            </div>

            <p class="text-xs text-muted-foreground">
                Quelle: <a href="https://www.e-recht24.de" target="_blank" rel="noopener noreferrer" class={link}>eRecht24</a>
            </p>
        </div>
    </section>

</Base>
