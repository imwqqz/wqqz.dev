---
import Base from "../layouts/Base.astro";
---
<Base title="Page Not Found" description="The page you are looking for does not exist.">
  <main class="container mx-auto px-6 min-h-[100vh] flex items-center justify-center">
    <div class="max-w-3xl mx-auto text-center">
      <h1 class="text-5xl font-bold mb-4">404</h1>
      <p class="text-foreground/90 mb-2">Page not found</p>
      <p class="text-muted-foreground mb-8">The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.</p>
      <a href="/" class="inline-flex items-center gap-2 rounded-md bg-primary text-primary-foreground hover:bg-primary/90 px-5 py-3 text-sm font-medium transition-colors">Go back home</a>
    </div>
  </main>
</Base>
