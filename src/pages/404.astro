---
import Base from "../layouts/Base.astro";
---
<Base title="Seite nicht gefunden" description="Die gesuchte Seite existiert nicht.">
  <main class="container mx-auto px-6 min-h-[100vh] flex items-center justify-center">
    <div class="max-w-3xl mx-auto text-center">
      <h1 class="text-5xl font-bold mb-4">404</h1>
      <p class="text-foreground/90 mb-2">Seite nicht gefunden</p>
      <p class="text-muted-foreground mb-8">Die gesuchte Seite wurde möglicherweise entfernt, umbenannt oder ist vorübergehend nicht verfügbar.</p>
      <a href="/" class="inline-flex items-center gap-2 rounded-md bg-primary text-primary-foreground hover:bg-primary/90 px-5 py-3 text-sm font-medium transition-colors">Zur Startseite</a>
    </div>
  </main>
</Base>
