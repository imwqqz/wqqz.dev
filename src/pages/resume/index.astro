---
import Base from "../../layouts/Base.astro";
import { Shield, Briefcase, GraduationCap, HeartHandshake, MapPin } from '@lucide/astro';
import { resume, contacts } from "../../lib/info";
---

<Base title={`${resume.name} - Lebenslauf`}
      description={`Lebenslauf von ${resume.name}, ${resume.role}.`}>

    <section class="container mx-auto px-6 pt-16 pb-20 flex-grow flex flex-col justify-center">
        <div class="max-w-3xl mx-auto w-full">
            <h1 class="mb-2 text-4xl md:text-5xl font-bold tracking-tight text-balance">{resume.name}</h1>
            <p class="mb-1 text-lg md:text-xl text-muted-foreground">{resume.role}</p>
            {resume.location && (
                <p class="mb-6 text-sm text-muted-foreground flex items-center gap-1.5">
                    <MapPin size={14} /> {resume.location}
                </p>
            )}

            <h2 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-3">
                Kontakt
            </h2>

            <div class="mb-10 p-4 border border-border/70 bg-card rounded-lg">
                <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
                    {contacts.map((contact) => (
                        <div>
                            [{contact.label}: <a
                                href={contact.href}
                                target={contact.target}
                                rel={contact.rel}
                                class="text-muted-foreground underline underline-offset-2 decoration-accent/50 hover:text-accent hover:decoration-accent transition-colors"
                            >{contact.text}</a>]
                        </div>
                    ))}
                </div>
            </div>

            <div class="mb-10">
                <h2 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-3">
                    Profil
                </h2>
                <p class="text-base md:text-lg text-foreground/85 leading-relaxed text-pretty">
                    {resume.bio}
                </p>
            </div>

            {resume.experience && resume.experience.length > 0 && (
                <div class="mb-10">
                    <h2 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-4 flex items-center gap-2">
                        <Briefcase size={14} class="text-muted-foreground" />
                        <span>Berufserfahrung</span>
                    </h2>
                    <div class="space-y-6">
                        {resume.experience.map((exp) => (
                            <div class="border-l-2 border-border/60 pl-4 space-y-1.5">
                                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                                    <h3 class="text-base font-semibold text-foreground">
                                        {exp.role} {exp.company && <span class="text-muted-foreground font-normal">@ {exp.company}</span>}
                                    </h3>
                                    <span class="text-xs text-muted-foreground shrink-0">{exp.period}</span>
                                </div>
                                {exp.location && <p class="text-xs text-muted-foreground">{exp.location}</p>}
                                {exp.description.length > 0 && (
                                    <ul class="list-disc list-inside space-y-1 text-sm text-foreground/80">
                                        {exp.description.map((desc) => (
                                            <li class="text-pretty">{desc}</li>
                                        ))}
                                    </ul>
                                )}
                            </div>
                        ))}
                    </div>
                </div>
            )}

            {resume.volunteering && resume.volunteering.length > 0 && (
                <div class="mb-10">
                    <h2 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-4 flex items-center gap-2">
                        <HeartHandshake size={14} class="text-muted-foreground" />
                        <span>Ehrenamt</span>
                    </h2>
                    <div class="space-y-6">
                        {resume.volunteering.map((vol) => (
                            <div class="border-l-2 border-border/60 pl-4 space-y-1.5">
                                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                                    <h3 class="text-base font-semibold text-foreground">
                                        {vol.role} <span class="text-muted-foreground font-normal">@ {vol.href ? (
                                            <a
                                                href={vol.href}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="underline underline-offset-2 decoration-accent/50 hover:text-accent hover:decoration-accent transition-colors"
                                            >{vol.company}</a>
                                        ) : vol.company}</span>
                                    </h3>
                                    {vol.period && <span class="text-xs text-muted-foreground shrink-0">{vol.period}</span>}
                                </div>
                                <ul class="list-disc list-inside space-y-1 text-sm text-foreground/80">
                                    {vol.description.map((desc) => (
                                        <li class="text-pretty">{desc}</li>
                                    ))}
                                </ul>
                            </div>
                        ))}
                    </div>
                </div>
            )}

            {resume.skills && resume.skills.length > 0 && (
                <div class="mb-10">
                    <h2 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-4 flex items-center gap-2">
                        <Shield size={14} class="text-muted-foreground" />
                        <span>Kenntnisse</span>
                    </h2>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        {resume.skills.map((cat) => (
                            <div class="p-3.5 border border-border/60 rounded-md bg-card">
                                <h3 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-2">{cat.category}</h3>
                                <div class="flex flex-wrap gap-1.5">
                                    {cat.items.map((skill) => (
                                        <span class="text-xs px-2 py-0.5 rounded border border-border bg-card font-mono text-muted-foreground">
                                            {skill}
                                        </span>
                                    ))}
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            )}

            {((resume.education && resume.education.length > 0) || (resume.certifications && resume.certifications.length > 0)) && (
                <div class="mb-10">
                    <h2 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-4 flex items-center gap-2">
                        <GraduationCap size={14} class="text-muted-foreground" />
                        <span>Ausbildung & Zertifikate</span>
                    </h2>
                    <div class="space-y-4">
                        {resume.education?.map((edu) => (
                            <div class="border-l-2 border-border/60 pl-4 space-y-1">
                                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                                    <h3 class="text-sm font-semibold text-foreground">{edu.degree}</h3>
                                    <span class="text-xs text-muted-foreground shrink-0">{edu.period}</span>
                                </div>
                                <p class="text-xs text-muted-foreground">{edu.institution}</p>
                                {edu.details && edu.details.length > 0 && (
                                    <ul class="list-disc list-inside space-y-1 pt-1 text-sm text-foreground/80">
                                        {edu.details.map((detail) => (
                                            <li class="text-pretty">{detail}</li>
                                        ))}
                                    </ul>
                                )}
                            </div>
                        ))}
                    </div>
                    {resume.certifications && resume.certifications.length > 0 && (
                        <div class="mt-6 p-3.5 border border-border/60 rounded-md bg-card">
                            <h3 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-3">Zertifikate</h3>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3">
                                {resume.certifications.map((cert) => (
                                    <div class="border-l-2 border-border/60 pl-3 space-y-0.5">
                                        <div class="flex items-baseline justify-between gap-2">
                                            <h4 class="text-sm font-semibold text-foreground text-pretty">{cert.name}</h4>
                                            <span class="text-xs text-muted-foreground shrink-0">{cert.date}</span>
                                        </div>
                                        <p class="text-xs text-muted-foreground">{cert.issuer}</p>
                                    </div>
                                ))}
                            </div>
                        </div>
                    )}
                </div>
            )}
        </div>
    </section>

</Base>
