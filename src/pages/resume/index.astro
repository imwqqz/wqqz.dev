---
import Base from "../../layouts/Base.astro";
import { Download, KeyRound, Shield, Briefcase, GraduationCap } from '@lucide/astro';
import { resume, contacts } from "../../lib/info";
---

<Base title={`${resume.name} - Resume`}
      description={`Cybersecurity Specialist resume for ${resume.name}. Penetration testing, threat analysis, security architecture, and system hardening.`}>

    <section class="container mx-auto px-6 pt-16 pb-20 flex-grow flex flex-col justify-center">
        <div class="max-w-3xl mx-auto w-full">
            <h1 class="mb-2 text-4xl md:text-5xl font-bold tracking-tight text-balance">{resume.name}</h1>
            <p class="mb-6 text-lg md:text-xl text-muted-foreground">{resume.role}</p>

            <h2 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-3">
                Connect
            </h2>

            <div class="mb-10 p-4 border border-border/70 bg-card rounded-lg">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div class="flex flex-col gap-1.5 text-sm">
                        <div>
                            [cv: <a
                                href={resume.downloads.cv.href}
                                download={resume.downloads.cv.filename ?? "wqqz-cv.pdf"}
                                class="text-muted-foreground underline underline-offset-2 decoration-accent/50 hover:text-accent hover:decoration-accent transition-colors font-medium"
                            >{resume.downloads.cv.text}</a>]
                        </div>
                        <div>
                            [pgp: <a
                                href={resume.downloads.pgp.href}
                                download={resume.downloads.pgp.filename ?? "publickey.asc"}
                                class="text-muted-foreground underline underline-offset-2 decoration-accent/50 hover:text-accent hover:decoration-accent transition-colors font-medium"
                            >{resume.downloads.pgp.text}</a>]
                        </div>
                        {resume.pgpFingerprint && (
                            <div class="text-s break-all">
                                [fingerprint: <span class="text-foreground/80">{resume.pgpFingerprint}</span>]
                            </div>
                        )}
                    </div>
                    <div class="flex items-center gap-2.5 shrink-0">
                        <a
                            href={resume.downloads.cv.href}
                            download={resume.downloads.cv.filename ?? "wqqz-cv.pdf"}
                            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-semibold rounded-md border border-border bg-foreground text-background hover:bg-foreground/90 transition-colors shadow-sm"
                        >
                            <Download size={14} /> Download CV
                        </a>
                        <a
                            href={resume.downloads.pgp.href}
                            download={resume.downloads.pgp.filename ?? "publickey.asc"}
                            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-semibold rounded-md border border-border bg-card text-foreground hover:border-accent/50 hover:text-accent transition-colors"
                        >
                            <KeyRound size={14} /> PGP Key
                        </a>
                    </div>
                </div>

                <div class="mt-4 pt-4 border-t border-border/60 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
                    {contacts.map((contact) => (
                        <div>
                            [{contact.label}: <a
                                href={contact.href}
                                target={contact.target}
                                rel={contact.rel}
                                class="text-muted-foreground underline underline-offset-2 decoration-accent/50 hover:text-accent hover:decoration-accent transition-colors"
                            >{contact.text}</a>]
                        </div>
                    ))}
                </div>
            </div>

            <div class="mb-10">
                <h2 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-3">
                    Profile Summary
                </h2>
                <p class="text-base md:text-lg text-foreground/85 leading-relaxed text-pretty">
                    {resume.bio}
                </p>
            </div>

            {resume.experience && resume.experience.length > 0 && (
                <div class="mb-10">
                    <h2 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-4 flex items-center gap-2">
                        <Briefcase size={14} class="text-muted-foreground" />
                        <span>Experience</span>
                    </h2>
                    <div class="space-y-6">
                        {resume.experience.map((exp) => (
                            <div class="border-l-2 border-border/60 pl-4 space-y-1.5">
                                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                                    <h3 class="text-base font-semibold text-foreground">
                                        {exp.role} {exp.company && <span class="text-muted-foreground font-normal">@ {exp.company}</span>}
                                    </h3>
                                    <span class="text-xs text-muted-foreground shrink-0">{exp.period}</span>
                                </div>
                                <ul class="list-disc list-inside space-y-1 text-sm text-foreground/80">
                                    {exp.description.map((desc) => (
                                        <li class="text-pretty">{desc}</li>
                                    ))}
                                </ul>
                            </div>
                        ))}
                    </div>
                </div>
            )}

            {resume.skills && resume.skills.length > 0 && (
                <div class="mb-10">
                    <h2 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-4 flex items-center gap-2">
                        <Shield size={14} class="text-muted-foreground" />
                        <span>Technical Skills</span>
                    </h2>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        {resume.skills.map((cat) => (
                            <div class="p-3.5 border border-border/60 rounded-md bg-card">
                                <h3 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-2">{cat.category}</h3>
                                <div class="flex flex-wrap gap-1.5">
                                    {cat.items.map((skill) => (
                                        <span class="text-xs px-2 py-0.5 rounded border border-border bg-card font-mono text-muted-foreground">
                                            {skill}
                                        </span>
                                    ))}
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            )}

            {resume.education && resume.education.length > 0 && (
                <div class="mb-10">
                    <h2 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-4 flex items-center gap-2">
                        <GraduationCap size={14} class="text-muted-foreground" />
                        <span>Education & Certifications</span>
                    </h2>
                    <div class="space-y-4">
                        {resume.education.map((edu) => (
                            <div class="border-l-2 border-border/60 pl-4 space-y-1">
                                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                                    <h3 class="text-sm font-semibold text-foreground">{edu.degree}</h3>
                                    <span class="text-xs text-muted-foreground shrink-0">{edu.period}</span>
                                </div>
                                <p class="text-xs text-muted-foreground">{edu.institution}</p>
                            </div>
                        ))}
                    </div>
                </div>
            )}
        </div>
    </section>

</Base>
